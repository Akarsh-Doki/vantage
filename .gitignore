# ---- Secrets & env (NEVER commit these) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---- Python (backend) ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / frontend ----
node_modules/
dist/
build/
.vite/
*.local
.eslintcache
npm-debug.log*
yarn-error.log*

# ---- Go (fetcher) ----
fetcher/fetcher
fetcher/*.exe
*.test
*.out

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Logs & misc ----
*.log
tmp/
.cache/

# ---- Eval run artifacts (keep the dir via .gitkeep, ignore reports) ----
backend/evals/results/*.json

# ---- Eval research cache (keep the dir via .gitkeep, ignore cached research) ----
backend/evals/cache/*.json
