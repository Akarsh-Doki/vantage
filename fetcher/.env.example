# Fetcher environment (copied to .env by scripts/setup.sh).
PORT=8090

# Shared secret the backend must send on every request (see docs/threat-model.md §1).
FETCHER_AUTH_TOKEN=

# Fetch limits — defaults match docs/threat-model.md; raise only with a reason.
FETCH_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=3
