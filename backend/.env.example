ANTHROPIC_API_KEY=
TAVILY_API_KEY=
FETCHER_URL=http://localhost:8080
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
HAIKU_MODEL=
SONNET_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vantage
OPENAI_API_KEY=

# --- Auth (Supabase JWT verification) ---
# Use SUPABASE_JWT_SECRET for HS256 projects, or SUPABASE_JWKS_URL for
# projects using asymmetric (RS256/ES256) signing keys. Set exactly one.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# --- HTTP surface ---
# Exact allowed CORS origin(s), comma-separated. No wildcards.
FRONTEND_ORIGIN=http://localhost:5173

# --- Abuse & cost protection (all optional; defaults shown) ---
# Rate limits are slowapi strings like "5/minute" or "100/hour".
RATE_LIMIT_PER_IP=5/minute
RATE_LIMIT_PER_USER=20/minute
# Total free samples across ALL users per day (account-level spend guard).
DAILY_SAMPLE_CAP=100
# Full runs a single paid user may start per day.
PAID_DAILY_RUN_LIMIT=20
# Max graph runs executing concurrently.
GRAPH_CONCURRENCY=3
# A single run costing more than this (integer cents) logs a warning.
COST_WARN_CENTS=100
