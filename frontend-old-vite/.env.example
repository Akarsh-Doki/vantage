# Frontend environment (copied to .env.local by scripts/setup.sh).
# VITE_-prefixed values are PUBLIC — they are compiled into the client bundle.
# Never put a secret here; the Supabase anon key is safe because RLS enforces access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
